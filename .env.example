# Copy to .env locally. On Vercel, set the SAME names in Project Settings → Environment Variables
# (Production + Preview). Then Redeploy.

SESSION_SECRET=change-me-to-a-long-random-string

NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=
NUXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Realtime Database (matchmaking + WebRTC signal). Firebase Console → Build → Realtime Database → Create
# Example: https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com
# or regional: https://YOUR_PROJECT_ID-default-rtdb.europe-west1.firebasedatabase.app
NUXT_PUBLIC_FIREBASE_DATABASE_URL=
